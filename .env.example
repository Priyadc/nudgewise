# ─── Required ──────────────────────────────────────────────
# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nudgewise?retryWrites=true&w=majority"

# NextAuth — generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
# Your site URL (http://localhost:3000 locally, https://your-app.vercel.app in production)
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Google sign-in (optional but recommended) ─────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web)
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Image uploads (Cloudinary free tier) ──────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─── Push notifications (Web Push) ─────────────────────────
# Generate with:  npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ─── Email reminders + password reset (SMTP) ───────────────
# Gmail: smtp.gmail.com, port 465, use a Google "App password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Nudgewise <you@gmail.com>"

# ─── Reminder scheduler ────────────────────────────────────
# Any long random string. The scheduler calls /api/cron/reminders with
# header  Authorization: Bearer <CRON_SECRET>
CRON_SECRET="replace-with-another-long-random-string"
